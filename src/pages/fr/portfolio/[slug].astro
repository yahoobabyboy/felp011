---
import PiecePage from "../../../components/PiecePage.astro";
import { getPieceSlugs } from "../../../lib/content";

export async function getStaticPaths() {
  const slugs = await getPieceSlugs("fr");
  return slugs.map((slug) => ({ params: { slug } }));
}
---

<PiecePage  locale="fr" slug={Astro.params.slug!} />
