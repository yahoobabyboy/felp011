---
import PiecePage from "../../components/PiecePage.astro";
import { getPieceSlugs } from "../../lib/content";

export async function getStaticPaths() {
  const slugs = await getPieceSlugs("en");
  return slugs.map((slug) => ({ params: { slug } }));
}
---

<PiecePage  locale="en" slug={Astro.params.slug!} />
