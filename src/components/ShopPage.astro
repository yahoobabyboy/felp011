---
import { UI, type Locale } from "../lib/i18n";
import { href, getProducts, getSite } from "../lib/content";
import Base from "../layouts/Base.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const site = await getSite();

const products = await getProducts(locale);
const copy = site.pages.shop[locale] || site.pages.shop.en;
const available = products.filter((p) => p.status === "available");
const soon = products.filter((p) => p.status !== "available");
const listed = available.length ? products : soon;
---

<Base
  locale={locale}
  path="shop"
  title={ui.nav.shop}
  description={copy || `${ui.nav.shop} — ${site.brand}`}
  site={site}
>
  <section class="wrap section">
    <p class="eyebrow">{ui.nav.shop}</p>
    <h1>{available.length ? ui.nav.shop : ui.shop.comingSoon}</h1>

    {copy && <p class="lede" style="margin-top:1rem">{copy}</p>}

    {
      !available.length && (
        <p class="empty" style="margin-top:1.5rem">
          {ui.shop.notify}
        </p>
      )
    }

    {
      listed.length > 0 && (
        <div class="grid grid--art" style="margin-top:2.5rem">
          {listed.map((product) => (
            <article class="card">
              <div class="card__media">
                {product.cover ? (
                  <img src={product.cover} alt={product.title} width="800" height="1000" loading="lazy" decoding="async" />
                ) : (
                  <div class="placeholder">
                    <span aria-hidden="true">◻</span>
                    <span>{product.title}</span>
                  </div>
                )}
              </div>

              <div class="card__body">
                <h2 class="card__title" style="font-size:var(--step-1)">
                  {product.title}
                </h2>
                {product.price && <p class="card__meta">{product.price}</p>}
                {product.status !== "available" && <p class="card__meta">{ui.shop.comingSoon}</p>}
                {product.buyLink && product.status === "available" && (
                  <a class="btn" href={product.buyLink} rel="noopener" target="_blank">
                    {ui.shop.buy}
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      )
    }

    <div class="strip">
      <a class="btn btn--ghost" href={href("contact", locale)}>{ui.product.inquire}</a>
    </div>
  </section>
</Base>
