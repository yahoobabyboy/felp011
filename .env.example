# Cloudflare Pages environment variables.
#
# Copy to `.env` for local dev, or paste these into the Cloudflare dashboard
# under Settings > Environment variables. Set them for BOTH "Production" and
# "Preview" — they are separate, and forgetting Preview is a common trap.
#
# Every value here is optional. With none of them set the site still builds,
# deploys, and the contact form still accepts submissions — it just logs them
# to the Cloudflare function log instead of emailing you.

# Required for the contact form to actually deliver mail.
# Free tier: 100 emails/day, 300/month. Signup at resend.com.
# Mark this one SECRET in the dashboard so it is encrypted at rest.
RESEND_API_KEY=

# Where inquiries are delivered. Defaults to the address below if unset.
CONTACT_TO=contatofelp011@gmail.com

# The verified "from" address. Defaults to Resend's onboarding address, which
# can ONLY send to your own account's email. Once you verify a domain (e.g.
# felp011.com) you can use anything@yourdomain here.
CONTACT_FROM=

# Build-time: pin the Node version Cloudflare builds with. Set in the dashboard,
# NOT here — Cloudflare ignores .nvmrc and .node-version for Pages builds.
# Must be >= 22.12.0 (see "engines" in package.json).
NODE_VERSION=22
